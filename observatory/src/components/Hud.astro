---
// The observatory HUD, always legible over the spectacle: who the studio is,
// where to go, and the reading legend. This is the clarity layer.
const nav = [
  { href: "#portfolio", label: "Work" },
  { href: "#services", label: "Services" },
  { href: "#process", label: "Process" },
  { href: "#contact", label: "Contact" },
];
const sections = ["hero", "portfolio", "deepfield", "services", "process", "contact", "outro"];
---

<div class="hud" id="hud">
  <div class="studio pad">
    <div class="studio__name">
      <span aria-hidden="true" style="color:var(--sirius)">✦</span> SIRIUS <b>ASCENT</b>
    </div>
    <div class="studio__role">Digital Architecture Studio · Pretoria</div>
  </div>
  <div class="sys pad">
    <button class="snd" id="snd" type="button" aria-pressed="false">
      <span class="snd__i" aria-hidden="true"></span> Sound Off
    </button>
  </div>
  <nav class="nav" aria-label="Primary">
    {nav.map((n) => <a data-mag href={n.href}>{n.label}</a>)}
  </nav>
</div>

<nav class="prog" id="prog" aria-label="Journey progress">
  <span class="prog__origin" aria-hidden="true"></span>
  {sections.map((s, i) => <a href={`#${s}`} data-i={i} aria-label={s} />)}
  <span class="prog__ship" data-ship aria-hidden="true">
    <span class="prog__trail"></span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M12 21c2.5-2 4-4.7 4-8 0-3.2-1.6-6.4-4-8.5C9.6 6.6 8 9.8 8 13c0 3.3 1.5 6 4 8Z" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="11" r="1.5" fill="#4d6bff"/>
      <path d="M8.3 13.5 5.5 16.5M15.7 13.5 18.5 16.5"/>
    </svg>
  </span>
</nav>

<div class="legend" id="legend">
  <i><span class="k k--r"></span> Risen: live</i>
  <i><span class="k k--p"></span> Plotted: demo</i>
  <i>◆ Hover a star · click to enter its system</i>
</div>

<!-- returning-visitor moment + observatory log + transmission-return confirmation -->
<div class="welcome-back" data-welcome aria-hidden="true" hidden>Welcome back, explorer.</div>
<div class="welcome-back return-note" data-return-note role="status" hidden>✦ Signal transmitted · Sirius Ascent will respond within 24–48 hours</div>
<p class="log-readout mono" data-log aria-hidden="true">Systems explored · 0 / 10</p>
