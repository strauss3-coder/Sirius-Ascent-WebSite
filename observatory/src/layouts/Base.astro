---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative OG image path */
  image?: string;
  /** Descriptive alt for the OG/Twitter image */
  imageAlt?: string;
  /** og:type — "website" (default) or "article" for case studies */
  type?: string;
  /** Overrides the <html> theme; the site is a committed night sky */
  noindex?: boolean;
  /** Extra JSON-LD injected into <head> (e.g. per-project CreativeWork) */
  schema?: Record<string, unknown>;
}

const base = import.meta.env.BASE_URL; // "/" in prod, "/sirius-observatory/" in preview

const {
  title,
  description,
  image = `${base}og/observatory.png`,
  imageAlt = "Sirius Ascent — digital architecture studio",
  type = "website",
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const siteUrl = Astro.site?.href;

// Studio entity — ProfessionalService/Organization, reused across pages.
const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#studio`,
  name: "Sirius Ascent",
  description:
    "Digital architecture studio in Pretoria — websites engineered like instruments.",
  url: siteUrl,
  image: new URL(`${base}og/observatory.png`, Astro.site).href,
  areaServed: "South Africa",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pretoria",
    addressRegion: "Gauteng",
    addressCountry: "ZA",
  },
  knowsAbout: [
    "Web design",
    "Web development",
    "SEO",
    "Brand identity",
    "Google Business Profile",
  ],
  sameAs: ["https://instagram.com/sirius_ascent_"],
};

// The site itself — helps Search Console understand the property.
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: "Sirius Ascent",
  url: siteUrl,
  inLanguage: "en-ZA",
  publisher: { "@id": `${siteUrl}#studio` },
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Stable viewport unit: locked to width/orientation, NOT the mobile address
        bar. Section heights use calc(var(--vh)*N) so the layout can't shift when
        the browser chrome expands or collapses — the core scroll-stability fix. */}
    <script is:inline>
      (function () {
        var d = document.documentElement, w = -1;
        function set() {
          if (window.innerWidth === w) return;
          w = window.innerWidth;
          d.style.setProperty("--vh", window.innerHeight * 0.01 + "px");
        }
        set();
        window.addEventListener("resize", set, { passive: true });
        window.addEventListener("orientationchange", function () { w = -1; setTimeout(set, 180); });
      })();
    </script>
    {/* Failsafe: if the experience engine hasn't booted a few seconds after load
        (e.g. a CDN cache window served a stale page whose bundle 404'd, or a
        script errored on an old browser), reveal all content as a plain, fully
        readable page instead of leaving it blank. The site can never break. */}
    <script is:inline>
      window.addEventListener("load", function () {
        setTimeout(function () {
          if (!window.__siriusBooted) document.documentElement.classList.add("sirius-fallback");
        }, 4000);
      });
    </script>
    <!-- Icons + PWA manifest -->
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#08090c" />
    <meta name="msapplication-TileColor" content="#08090c" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sirius Ascent" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sirius Ascent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_ZA" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Brand type: Sora (display/sans), Cormorant Garamond (serif), JetBrains Mono (telemetry) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&family=Sora:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
