---
import Base from "../layouts/Base.astro";
import Cosmos from "../components/Cosmos.astro";
import Hud from "../components/Hud.astro";
import { projects, services, processStages } from "../data/universe.js";
const base = import.meta.env.BASE_URL;

// Deep Field: the three flagship systems (no heavy imagery), tagged with their
// number in the full constellation.
const deepFieldSlugs = ["venom-racing", "rhinos-pool-club", "riverside-padel"];
const deepField = deepFieldSlugs.map((slug) => {
  const i = projects.findIndex((p) => p.slug === slug);
  return { ...projects[i], sys: String(i + 1).padStart(2, "0") };
});
---

<Base
  title="Sirius Ascent — Digital Architecture Studio, Pretoria"
  description="A living star map of the work we've built. Sirius Ascent designs and builds websites engineered like instruments — for South African businesses that intend to be taken seriously."
>
  <Cosmos />
  <Hud />

  <!-- onboarding cue: tells first-time visitors the universe responds to scroll -->
  <div class="scroll-cue" id="scrollCue" aria-hidden="true">
    <span class="scroll-cue__label mono">Scroll to begin the descent</span>
    <span class="scroll-cue__rail"><i></i></span>
  </div>

  <main id="main">
    <section class="sec" id="hero">
      <p class="hero__eye">A living star map</p>
      <h1 class="hero__title">We design websites<br />engineered like <em>instruments.</em></h1>
      <div class="hero__row">
        <p class="hero__sub">
          This is our universe. <b>Sirius is the studio;</b> every other light is a
          business we built. Follow the star — it will guide you down through the observatory.
        </p>
        <div class="hero__cta">
          <a class="btn btn--p" data-mag href="#portfolio">Enter the sky ↓</a>
          <a class="btn btn--g" data-mag href="#contact">Establish contact</a>
        </div>
      </div>
    </section>

    <section class="sec sec--travel" id="portfolio">
      <div class="head" data-head>
        <p class="eye">The stars · portfolio</p>
        <h2 class="h2">Every project <em>is a star.</em></h2>
        <p class="subl">Scroll to travel the constellation — Sirius reaches out to each project it built, one by one.</p>
        <p class="count mono" id="portfolioCount" aria-hidden="true">01 / 10</p>
      </div>
      <!-- Canvas is decorative; this is the real, accessible route to every case study -->
      <nav class="sr-nav" aria-label="Project case studies">
        <ul>
          {projects.map((p) => (
            <li>
              <a href={`${base}work/${p.slug}`}>
                {p.name} — {p.status === "risen" ? "live site" : "demo"} case study
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    <!-- ===================== THE DEEP FIELD ===================== -->
    <section class="sec-df" id="deepfield" aria-label="The deep field — featured systems">
      <div class="df-intro">
        <p class="eye">The deep field</p>
        <h2 class="h2">A cluster of <em>living systems.</em></h2>
        <p class="subl">Three signals glinting in the dark — the flagship builds. Approach one and enter its system.</p>
      </div>

      <div class="df-systems">
        {deepField.map((p) => (
          <a class="df-system" href={`${base}work/${p.slug}`} style={`--accent:${p.accent}`} aria-label={`${p.name} — enter the system`}>
            <span class="df-orb" aria-hidden="true">
              <span class="df-core"></span>
              <span class="df-ring"><i></i></span>
              <span class="df-ring df-ring--2"><i></i></span>
              <span class="df-belt">
                {Array.from({ length: 8 }).map(() => <i></i>)}
              </span>
            </span>
            <span class="df-sys-name mono">System {p.sys} <span class="df-slash">//</span> {p.name}</span>
            <span class="df-sys-meta mono">
              <span class={`df-status df-status--${p.status}`}>{p.status === "risen" ? "Risen" : "Plotted"}</span>
              <span class="df-dot" aria-hidden="true">·</span> {p.industry}
            </span>
            <span class="df-sys-cta mono">Enter the system →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="sec" id="services">
      <div class="head" data-head>
        <p class="eye">Galaxies · services</p>
        <h2 class="h2">What we <em>set in orbit.</em></h2>
        <p class="subl">Each capability circles the studio. <b>Hover a body</b> to name it.</p>
        <ul class="sr-only">
          {services.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <section class="sec" id="process">
      <div class="head" data-head>
        <p class="eye">Orbital paths · process</p>
        <h2 class="h2">How the work <em>comes into orbit.</em></h2>
        <p class="subl">Five ordered passes, from first contact to long-term care.</p>
        <ol class="sr-only">
          {processStages.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </section>

    <section class="sec" id="contact">
      <div class="head" data-head>
        <p class="eye">Establish communication · contact</p>
        <h2 class="h2">Make <em>first contact.</em></h2>
      </div>

      <div class="tx">
        <button type="button" class="tx__activate" data-console-open>
          <span class="tx__beacon" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="tx__activate-label">Transmit a signal</span>
          <span class="tx__activate-sub mono">Initiate first contact with Sirius Ascent</span>
        </button>
      </div>
    </section>

    <!-- ===================== THE ENDING ===================== -->
    <section class="sec-outro" id="outro" aria-label="Journey's end">
      <div class="outro__end" data-outro-end>
        <p class="outro__line1">Every great journey begins with a single signal.</p>
        <p class="outro__line2">Begin yours.</p>
        <button type="button" class="outro__btn" data-console-open>Begin transmission</button>
      </div>
    </section>
  </main>

  <!-- ===================== FIRST CONTACT CONSOLE ===================== -->
  <div class="console" id="console" role="dialog" aria-modal="true" aria-label="Transmission console" aria-hidden="true" hidden>
    <div class="console__veil" aria-hidden="true"></div>
    <div class="console__star" aria-hidden="true"><span class="console__beam"></span></div>
    <div class="console__inner">
      <p class="console__status mono" data-console-status aria-live="polite">Establishing connection…</p>
      <div class="console__stage" data-console-stage></div>
    </div>
    <button type="button" class="console__close mono" data-console-close aria-label="Abort transmission">Abort ✕</button>
  </div>
</Base>

<script>
  import { initConsole } from "../scripts/console.js";
  import { initDeepField } from "../scripts/deepfield.js";
  import { initMagic } from "../scripts/magic.js";
  function initScrollCue() {
    const cue = document.getElementById("scrollCue");
    if (!cue) return;
    const hide = () => { cue.classList.add("gone"); removeEventListener("scroll", onScroll); };
    const onScroll = () => { if ((window.scrollY || 0) > 60) hide(); };
    addEventListener("scroll", onScroll, { passive: true });
  }
  const run = () => { initMagic(); initConsole(); initDeepField(); initScrollCue(); };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run);
  else run();
</script>
